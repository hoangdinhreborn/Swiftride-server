            "description": "Tài xế B cập nhật vị trí lân cận (cách 300m) để sẵn sàng nhận cuốc dự phòng khi Tài xế A từ chối."
          },
          "response": []
        },
        {
          "name": "2.3 Get Fare Quote (MatchingService)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pickupLat\": 10.7721,\n    \"pickupLng\": 106.6980,\n    \"destinationLat\": 10.7290,\n    \"destinationLng\": 106.7190,\n    \"promoCode\": \"SWIFTRIDE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quote"
              ]
            },
            "description": "Khách hàng tra cứu báo giá ước tính. MatchingService tự động áp dụng Strategy Pattern (Standard / Surge theo mật độ tài xế / Promo)."
          },
          "response": []
        },
        {
          "name": "2.4 Request Trip (Rider Đặt xe -> Requested)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.environment.set('tripId', jsonData.id);",
                  "    pm.collectionVariables.set('tripId', jsonData.id);",
                  "    console.log('Saved tripId:', jsonData.id);",
                  "}",
                  "pm.test('Trip created with status Requested', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(jsonData.status).to.eql('Requested');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pickup\": \"Chợ Bến Thành (Quận 1)\",\n    \"pickupLat\": 10.7721,\n    \"pickupLng\": 106.6980,\n    \"destination\": \"Phú Mỹ Hưng (Quận 7)\",\n    \"destinationLat\": 10.7290,\n    \"destinationLng\": 106.7190,\n    \"promoCode\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "trips"
              ]
            },
            "description": "Rider tạo yêu cầu đặt xe. TripService tính cước qua MatchingService và lưu chuyến ở trạng thái Requested (chờ rider xác nhận giá)."
          },
          "response": []
        },
