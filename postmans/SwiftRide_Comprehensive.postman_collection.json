    {
      "name": "2. Trip Lifecycle & Driver Dispatching",
      "description": "Toàn bộ chu trình vòng đời chuyến đi theo State Pattern (11 trạng thái) & Thuật toán điều phối (Flowchart tài xế từ chối và retry).",
      "item": [
        {
          "name": "2.1 Update Driver A Location (Online)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverTokenA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"lat\": 10.7725,\n    \"lng\": 106.6990,\n    \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/drivers/me/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drivers",
                "me",
                "location"
