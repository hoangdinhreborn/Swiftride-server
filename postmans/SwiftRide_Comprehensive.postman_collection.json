    {
      "name": "3. Payment, Ledger & Gateway Aggregation",
      "description": "Thanh toán cước, ghi sổ cái kép Double-Entry, hoàn tiền/bồi thường SAGA và API Gateway Aggregation.",
      "item": [
        {
          "name": "3.1 Create Payment (Double-Entry Ledger & Idempotency)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.environment.set('paymentId', jsonData.id);",
                  "    pm.collectionVariables.set('paymentId', jsonData.id);",
                  "    console.log('Saved paymentId:', jsonData.id);",
                  "}",
                  "pm.test('Payment processed', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{riderToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tripId\": \"{{tripId}}\",\n    \"paymentToken\": \"tok_visa_valid\",\n    \"method\": \"Card\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "Thanh toán thủ công qua PaymentService với Idempotency Key, ghi nhận bút toán Nợ/Có (Double-Entry Ledger)."
          },
          "response": []
        },
        {
          "name": "3.2 Get Payment By Trip ID",
