{
  "info": {
    "_postman_id": "a7c8e921-5f21-4f81-9b12-984321098765",
    "name": "SwiftRide Complete API Collection (Demo)",
    "description": "Bộ Collection Postman hoàn chỉnh demo toàn bộ các luồng Microservices của hệ thống SwiftRide (.NET 10). Bao gồm tự động lấy JWT token, set environment variables, quản lý toàn bộ vòng đời chuyến đi (State Pattern), định vị GPS MatchingService, thanh toán Double-Entry Ledger và API Gateway Aggregation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Security",
      "description": "Thư mục chứa các API sinh JWT Bearer token theo phân quyền Role (Rider, Driver, Admin) qua API Gateway. Có script Test tự động set token vào Postman Environment / Collection Variables.",
      "item": [
        {
          "name": "1.1 Get Rider Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var responseText = pm.response.text();",
                  "// Endpoint trả về raw JWT string",
                  "var token = responseText.trim().replace(/^\"|\"$/g, '');",
                  "pm.environment.set('riderToken', token);",
                  "pm.collectionVariables.set('riderToken', token);",
                  "pm.environment.set('token', token);",
                  "pm.collectionVariables.set('token', token);",
                  "console.log('Rider Token set successfully:', token);",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token is not empty', function () {",
                  "    pm.expect(token).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"role\": \"Rider\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/dev/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dev",
                "token"
              ]
            },
            "description": "Sinh token JWT Bearer cho Rider (quyền đặt xe, hủy chuyến, xác nhận giá, xem chuyến)."
          },
          "response": []
        },
