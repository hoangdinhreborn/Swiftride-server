{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SwiftRide",
    "Audience": "SwiftRide"
  },
  "ReverseProxy": {
    "Routes": {
      "trips": {
        "ClusterId": "trip",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "perClient",
        "Match": {
          "Path": "/trips/{**catch-all}"
        }
      },
      "quote": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "perClient",
        "Match": {
          "Path": "/quote"
        }
      },
      "match": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "perClient",
        "Match": {
          "Path": "/match"
        }
      },
      "drivers": {
        "ClusterId": "matching",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "perClient",
        "Match": {
          "Path": "/drivers/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "perClient",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "trip": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5130"
          }
        }
      },
      "matching": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5197"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5273"
          }
        }
      }
    }
  }
}