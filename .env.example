# =============================================================================
# SwiftRide Environment Configuration Sample (.env.example)
# Sao chép file này thành .env để chạy docker-compose cục bộ:
#   cp .env.example .env
# =============================================================================

# PostgreSQL
POSTGRES_USER=swiftride
POSTGRES_PASSWORD=swiftride123
POSTGRES_DB=tripdb

# MongoDB (Mặc định không bật auth cho môi trường dev cục bộ)
MONGO_PORT=27017

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Secret Key (Dùng cho môi trường Production / Docker. Môi trường Dev dùng dotnet user-secrets)
# Chuỗi bảo mật tối thiểu 32 ký tự (256 bits)
JWT_KEY=dev-only-secret-key-change-me-at-least-32-chars!
JWT_ISSUER=SwiftRide
JWT_AUDIENCE=SwiftRide
