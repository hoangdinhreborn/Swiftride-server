# =============================================================================
# SwiftRide Server Environment Variables (.env.example)
# Sao chép file này thành .env trước khi chạy docker compose:
#   cp .env.example .env
# =============================================================================

# PostgreSQL Credentials (Dùng chung user/password cho cả 2 database container độc lập)
POSTGRES_USER=swiftride
POSTGRES_PASSWORD=swiftride123

# Database Ports:
# - TripService Database (tripdb): Host port 5432
# - PaymentService Database (paydb): Host port 5433

# RabbitMQ Credentials
RABBITMQ_USER=swiftride
RABBITMQ_PASSWORD=swiftride123

# JWT Configuration (Dùng chung cho toàn bộ hệ thống)
JWT_KEY=dev-only-secret-key-change-me-at-least-32-chars!
JWT_ISSUER=SwiftRide
JWT_AUDIENCE=SwiftRide

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
AUTOPAY_TOKEN=tok_default
